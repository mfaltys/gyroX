# Target: Seeed XIAO ESP32C3 (ESP32-C3 RISC-V, 4 MB flash)
CONFIG_IDF_TARGET="esp32c3"
CONFIG_IDF_TARGET_ESP32C3=y
CONFIG_ESPTOOLPY_FLASHSIZE_4MB=y
CONFIG_ESPTOOLPY_FLASHSIZE="4MB"

# Custom partition table (see partitions.csv)
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"
CONFIG_PARTITION_TABLE_FILENAME="partitions.csv"

# Wi-Fi softAP support (needed for the button-triggered web UI AP)
CONFIG_ESP_WIFI_SOFTAP_SUPPORT=y

# Bluetooth Low Energy (NimBLE) for BLE config + OTA
CONFIG_BT_ENABLED=y
CONFIG_BT_NIMBLE_ENABLED=y
# Match Android Chrome's automatic MTU request (517) so ~480-byte
# OTA chunks and large config JSON writes fit in a single ATT write
CONFIG_BT_NIMBLE_ATT_PREFERRED_MTU=517

# Bootloader rollback: a freshly OTA'd image boots as "pending verify";
# app_main marks it valid after a healthy init, else the next reboot
# falls back to the previous slot. NOTE: requires reflashing the
# bootloader (USB) once for this to take effect on existing devices.
CONFIG_BOOTLOADER_APP_ROLLBACK_ENABLE=y

# HTTP server limits for the web UI
CONFIG_HTTPD_MAX_REQ_HDR_LEN=2048
CONFIG_HTTPD_MAX_URI_LEN=1024

# Default log level: Info
CONFIG_LOG_DEFAULT_LEVEL_INFO=y
CONFIG_LOG_DEFAULT_LEVEL=3

# 1 kHz FreeRTOS tick for finer timing
CONFIG_FREERTOS_HZ=1000
